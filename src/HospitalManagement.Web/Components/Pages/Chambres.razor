@page "/chambres"
@attribute [Authorize(Roles = "Admin,Medecin,Infirmier,Receptionniste")]
@using System.Security.Claims
@using HospitalManagement.Web.Components.Layout

<PageTitle>Chambres & Lits</PageTitle>

<div class="page-card">
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 16px;">
        <RadzenHeading Size="HeadingSize.H3">Chambres & Lits</RadzenHeading>
                @if (CanWrite)
        {
            <RadzenButton Text="Nouvelle chambre" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => OpenNewChambre())" />
        }
    </RadzenStack>

    @if (isEditing)
    {
        <RadzenStack Gap="16px">
            <RadzenText Size="TextSize.Large">@(editingChambreId == 0 ? "Ajouter une chambre" : "Modifier la chambre")</RadzenText>
            <RadzenTextBox @bind-Value="chambreModel.Numero" Placeholder="Numéro" />
            <RadzenLabel Text="Étage" />
            <RadzenNumeric @bind-Value="chambreModel.Etage" />
            <RadzenLabel Text="Type" />
            <RadzenDropDown @bind-Value="chambreModel.Type" Data="Enum.GetValues<TypeChambre>()" />
            <RadzenLabel Text="Statut" />
            <RadzenDropDown @bind-Value="chambreModel.Statut" Data="Enum.GetValues<StatutChambre>()" />
            <RadzenLabel Text="Tarif journalier" />
            <RadzenNumeric @bind-Value="chambreModel.TarifJournalier" Format="C2" />
            <RadzenTextArea @bind-Value="chambreModel.Description" Placeholder="Description" />

            <RadzenHeading Size="HeadingSize.H5">Lits</RadzenHeading>
            @if (lits.Count > 0)
            {
                @foreach (var lit in lits)
                {
                    <RadzenStack Direction="FlexDirection.Row" Gap="8px" AlignItems="AlignItems.Center">
                        <RadzenTextBox @bind-Value="lit.Numero" Placeholder="N° lit" />
                        <RadzenDropDown @bind-Value="lit.Statut" Data="Enum.GetValues<StatutLit>()" />
                        <RadzenCheckBox @bind-Value="lit.EstAdapteEnfant" Text="Adapté enfant" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveLit(lit))" />
                    </RadzenStack>
                }
            }
            <RadzenButton Text="Ajouter un lit" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@AddLit" />

            <RadzenStack Direction="FlexDirection.Row" Gap="8px">
                <RadzenButton Text="Enregistrer" ButtonStyle="ButtonStyle.Primary" Click="@SaveChambre" />
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Secondary" Click="@CancelChambre" />
            </RadzenStack>
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid Data="@chambres" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn Property="Numero" Title="Numéro" />
                <RadzenDataGridColumn Property="Etage" Title="Étage" />
                <RadzenDataGridColumn Property="Type" Title="Type" />
                <RadzenDataGridColumn Property="Statut" Title="Statut" />
                <RadzenDataGridColumn Property="TarifJournalier" Title="Tarif / jour" FormatString="{0:C2}" />
                <RadzenDataGridColumn Property="Description" Title="Description" />
                <RadzenDataGridColumn Title="Lits">
                    <Template>
                        @((context as Chambre)?.Lits?.Count ?? 0)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="">
                    <Template>
                                            @if (CanWrite)
                    {
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => OpenEditChambre(context))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Style="margin-left: 6px;" Click="@(() => DeleteChambre(context))" />
                    }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    [Inject]
    private ApplicationDbContext Db { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

        [Inject]
    private DialogService Dialog { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());

    private bool CanWrite => currentUser.IsInAnyRole(RoleNames.ParcoursPatient);

    private List<Chambre> chambres = new();
    private List<Lit> lits = new();
    private bool isEditing;
    private int editingChambreId;
    private Chambre chambreModel = new();

        protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        }
        catch (InvalidOperationException)
        {
            currentUser = new ClaimsPrincipal(new ClaimsIdentity());
        }

        await Load();
    }

    private async Task Load()
    {
        chambres = await Db.Chambres
            .AsNoTracking()
            .Include(c => c.Lits)
            .OrderBy(c => c.Numero)
            .ToListAsync();
    }

        private void OpenNewChambre()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de créer une chambre.");
            return;
        }

        editingChambreId = 0;
        chambreModel = new Chambre { Type = TypeChambre.Simple, Statut = StatutChambre.Libre };
        lits = new();
        isEditing = true;
    }

        private void OpenEditChambre(Chambre c)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de modifier une chambre.");
            return;
        }

        editingChambreId = c.Id;
        chambreModel = new Chambre
        {
            Id = c.Id,
            Numero = c.Numero,
            Etage = c.Etage,
            Type = c.Type,
            Statut = c.Statut,
            TarifJournalier = c.TarifJournalier,
            Description = c.Description,
            CreatedAt = c.CreatedAt
        };
        lits = c.Lits?.ToList() ?? new();
        isEditing = true;
    }

    private void AddLit()
    {
        lits.Add(new Lit { Statut = StatutLit.Libre });
    }

    private void RemoveLit(Lit lit) => lits.Remove(lit);

        private async Task SaveChambre()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas d'enregistrer une chambre.");
            return;
        }
        if (string.IsNullOrWhiteSpace(chambreModel.Numero))
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", "Le numéro de chambre est obligatoire.");
            return;
        }

        if (chambreModel.TarifJournalier < 0)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", "Le tarif journalier ne peut pas être négatif.");
            return;
        }

        var duplicateBedNumber = lits
            .Where(lit => !string.IsNullOrWhiteSpace(lit.Numero))
            .GroupBy(lit => lit.Numero.Trim(), StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(group => group.Count() > 1);
        if (duplicateBedNumber is not null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", $"Le numéro de lit « {duplicateBedNumber.Key} » est dupliqué.");
            return;
        }

        var normalizedRoomNumber = chambreModel.Numero.Trim();
        var roomNumberExists = await Db.Chambres
            .AsNoTracking()
            .AnyAsync(chambre => chambre.Id != editingChambreId && chambre.Numero == normalizedRoomNumber);
        if (roomNumberExists)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", "Ce numéro de chambre existe déjà.");
            return;
        }

        if (editingChambreId == 0)
        {
            chambreModel.Numero = normalizedRoomNumber;
            chambreModel.Statut = GetRoomStatus(lits);
            Db.Chambres.Add(chambreModel);
            await Db.SaveChangesAsync();

            foreach (var lit in lits)
            {
                lit.Id = 0;
                lit.ChambreId = chambreModel.Id;
                lit.Chambre = null;
                Db.Lits.Add(lit);
            }
        }
        else
        {
            var existing = await Db.Chambres
                .Include(c => c.Lits)
                .FirstOrDefaultAsync(c => c.Id == editingChambreId);
            if (existing is null)
            {
                Notification.Notify(NotificationSeverity.Error, "Erreur", "La chambre est introuvable.");
                return;
            }

            existing.Numero = normalizedRoomNumber;
            existing.Etage = chambreModel.Etage;
            existing.Type = chambreModel.Type;
            existing.TarifJournalier = chambreModel.TarifJournalier;
            existing.Description = chambreModel.Description;
            existing.UpdatedAt = DateTime.UtcNow;

            var submittedBedIds = lits.Where(lit => lit.Id > 0).Select(lit => lit.Id).ToHashSet();
            foreach (var removedBed in existing.Lits.Where(lit => !submittedBedIds.Contains(lit.Id)).ToList())
            {
                Db.Lits.Remove(removedBed);
            }

            foreach (var submittedBed in lits)
            {
                if (submittedBed.Id == 0)
                {
                    existing.Lits.Add(new Lit
                    {
                        Numero = submittedBed.Numero.Trim(),
                        Statut = submittedBed.Statut,
                        EstAdapteEnfant = submittedBed.EstAdapteEnfant
                    });
                    continue;
                }

                var existingBed = existing.Lits.FirstOrDefault(lit => lit.Id == submittedBed.Id);
                if (existingBed is not null)
                {
                    existingBed.Numero = submittedBed.Numero.Trim();
                    existingBed.Statut = submittedBed.Statut;
                    existingBed.EstAdapteEnfant = submittedBed.EstAdapteEnfant;
                }
            }

            existing.Statut = GetRoomStatus(existing.Lits);
        }

        await Db.SaveChangesAsync();

        Notification.Notify(NotificationSeverity.Success, "Enregistré", "La chambre a été enregistrée.");
        isEditing = false;
        await Load();
    }

    private void CancelChambre() => isEditing = false;

        private async Task DeleteChambre(Chambre c)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de supprimer une chambre.");
            return;
        }
        if (!await Dialog.ConfirmDeleteAsync($"la chambre {c.Numero}", "La chambre doit être vide avant sa suppression."))
        {
            return;
        }

        if (c.Lits?.Any(lit => lit.Admissions.Any(admission => admission.Statut == StatutAdmission.EnCours)) == true)
        {
            Notification.Notify(NotificationSeverity.Warning, "Action impossible", "Cette chambre contient un lit lié à une admission en cours.");
            return;
        }

        Db.Chambres.Remove(c);
        await Db.SaveChangesAsync();
        Notification.Notify(NotificationSeverity.Warning, "Supprimé", "La chambre a été supprimée.");
        await Load();
    }

    private static StatutChambre GetRoomStatus(IEnumerable<Lit> beds)
        => RoomStatusCalculator.Calculate(beds.Select(bed => bed.Statut));
}
