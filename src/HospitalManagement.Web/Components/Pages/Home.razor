@code {
    private static readonly CultureInfo FrenchCulture = CultureInfo.GetCultureInfo("fr-FR");

    [Inject]
    private DashboardService Dashboard { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    [Inject]
    private UserManager<ApplicationUser> UserManagerService { get; set; } = default!;

    private DashboardSnapshot snapshot = DashboardSnapshot.Empty;
    private IReadOnlyDictionary<string, ModuleMetric> moduleMetrics =
        new Dictionary<string, ModuleMetric>();
    private string? userFirstName;
    private ClaimsPrincipal? currentUser;

    private string GreetingTitle => string.IsNullOrWhiteSpace(userFirstName)
        ? "Tableau de bord hospitalier"
        : $"Bonjour, {userFirstName}";

    private string TodayLabel => DateTime.Now.ToString("dddd d MMMM yyyy", FrenchCulture);

    private string SummaryLine =>
        $"{snapshot.TodayAppointments} rendez-vous aujourd'hui, "
        + $"{snapshot.OccupiedBeds} lit(s) occupé(s), "
        + $"{snapshot.LowStockMedicines} alerte(s) de stock";

    private int TotalConsultations => snapshot.ConsultationsByMonth.Sum(point => point.Count);

    private string FormatAmount(decimal amount) => $"{amount.ToString("N0", FrenchCulture)} €";

    protected override async Task OnInitializedAsync()
    {
        snapshot = await Dashboard.GetSnapshotAsync();
        moduleMetrics = BuildModuleMetrics(snapshot);
        await LoadCurrentUserAsync();
    }

    private ModuleMetric GetModuleMetric(AppModule module) =>
        moduleMetrics.TryGetValue(module.Url, out var metric) ? metric : new ModuleMetric(0, "à jour");

    private static IReadOnlyDictionary<string, ModuleMetric> BuildModuleMetrics(DashboardSnapshot data) =>
        new Dictionary<string, ModuleMetric>
        {
            ["/patients"] = new(data.TotalPatients, "dossiers"),
            ["/rendezvous"] = new(data.TodayAppointments, "aujourd'hui"),
            ["/chambres"] = new(data.OccupiedBeds, "lits occupés"),
            ["/laboratoire"] = new(data.PendingAnalyses, "analyses en attente"),
            ["/pharmacie"] = new(data.LowStockMedicines, "alertes de stock"),
            ["/personnel"] = new(data.ActiveStaff, "agents actifs"),
            ["/facturation"] = new(data.UnpaidInvoices, "factures à recouvrer")
        };

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUser = state.User;

            if (currentUser.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var user = await UserManagerService.GetUserAsync(currentUser);
            if (user is not null && !string.IsNullOrWhiteSpace(user.Prenom))
            {
                userFirstName = user.Prenom;
            }
        }
        catch (InvalidOperationException)
        {
            currentUser = new ClaimsPrincipal(new ClaimsIdentity());
        }
    }

    private bool CanAccessPatients => User.HasAnyRole(RoleNames.ParcoursPatient.ToArray());
    private bool CanAccessRendezVous => User.HasAnyRole(RoleNames.ParcoursPatient.ToArray());
    private bool CanAccessChambres => User.HasAnyRole(RoleNames.ParcoursPatient.ToArray());
    private bool CanAccessFacturation => User.HasAnyRole(RoleNames.Facturation.ToArray());
    private IReadOnlyList<AppModule> VisibleQuickAccess =>
        AppModuleCatalog.QuickAccess
            .Where(module => AppModuleCatalog.MayAccess(module, User))
            .ToList();

    private sealed record ModuleMetric(int Value, string Caption);

    private ClaimsPrincipal User => currentUser ?? new ClaimsPrincipal(new ClaimsIdentity());
}
