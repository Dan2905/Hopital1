@page "/patients"
@attribute [Authorize(Roles = "Admin,Medecin,Infirmier,Receptionniste")]
@using System.Security.Claims
@using HospitalManagement.Web.Components.Layout

<PageTitle>Gestion des Patients</PageTitle>

<div class="patients-page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Gestion</p>
            <h2>Patients</h2>
        </div>
        @if (CanWrite)
        {
            <RadzenButton Text="Nouveau patient" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenNew" />
        }
    </div>

    @if (isEditing)
    {
        <div class="editor-card">
            <div class="editor-header">
                <h3>@(editingId == 0 ? "Ajouter un patient" : "Modifier le patient")</h3>
            </div>

            <div class="form-grid">
                <div class="field-group">
                    <label>Nom</label>
                    <RadzenTextBox @bind-Value="model.Nom" Placeholder="Nom" />
                </div>

                <div class="field-group">
                    <label>Prénom</label>
                    <RadzenTextBox @bind-Value="model.Prenom" Placeholder="Prénom" />
                </div>

                <div class="field-group">
                    <label>Date de naissance</label>
                    <RadzenDatePicker @bind-Value="model.DateNaissance" Style="width: 100%;" />
                </div>

                <div class="field-group">
                    <label>Sexe</label>
                    <RadzenDropDown Data="Enum.GetValues<Sexe>()" @bind-Value="model.Sexe" Style="width: 100%;" />
                </div>

                <div class="field-group">
                    <label>Numéro de dossier</label>
                    <RadzenTextBox @bind-Value="model.NumeroDossier" Placeholder="N° dossier" />
                </div>

                <div class="field-group">
                    <label>Téléphone</label>
                    <RadzenTextBox @bind-Value="model.Telephone" Placeholder="Téléphone" />
                </div>

                <div class="field-group full-width">
                    <label>Email</label>
                    <RadzenTextBox @bind-Value="model.Email" Placeholder="Email" />
                </div>

                <div class="field-group full-width">
                    <label>Adresse</label>
                    <RadzenTextBox @bind-Value="model.Adresse" Placeholder="Adresse" />
                </div>

                <div class="field-group">
                    <label>Groupe sanguin</label>
                    <RadzenDropDown Data="Enum.GetValues<GroupeSanguin>()" @bind-Value="model.GroupeSanguin" Style="width: 100%;" />
                </div>

                <div class="field-group">
                    <label>Statut</label>
                    <RadzenDropDown Data="Enum.GetValues<StatutPatient>()" @bind-Value="model.Statut" Style="width: 100%;" />
                </div>

                <div class="field-group full-width">
                    <label>Allergies</label>
                    <RadzenTextArea @bind-Value="model.Allergies" Placeholder="Allergies" Rows="3" />
                </div>

                <div class="field-group full-width">
                    <label>Antécédents médicaux</label>
                    <RadzenTextArea @bind-Value="model.AntecedentsMedicaux" Placeholder="Antécédents médicaux" Rows="3" />
                </div>
            </div>

            <div class="form-actions">
                <RadzenButton Text="Enregistrer" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            </div>
        </div>
    }
    else
    {
        <div class="filter-bar">
            <RadzenTextBox Placeholder="Rechercher un patient..." @bind-Value="searchText" Style="width: 100%; max-width: 320px;" />
            <RadzenDropDown Data="statusOptions" @bind-Value="selectedStatus" Placeholder="Tous les statuts" Style="width: 200px;" />
        </div>

        <div class="patients-layout">
            <div class="patients-panel">
                <RadzenDataGrid Data="@filteredPatients" AllowPaging="true" PageSize="10" AllowSorting="true" EmptyText="Aucun patient trouvé.">
                    <Columns>
                        <RadzenDataGridColumn Property="NomComplet" Title="Patient" Sortable="false" />
                        <RadzenDataGridColumn Property="NumeroDossier" Title="N° dossier" />
                        <RadzenDataGridColumn Property="DateNaissance" Title="Naissance" FormatString="{0:dd/MM/yyyy}" />
                        <RadzenDataGridColumn Property="Telephone" Title="Téléphone" />
                        <RadzenDataGridColumn Property="Statut" Title="Statut">
                            <Template Context="patient">
                                <span class="status-pill @GetStatusClass(patient.Statut)">@GetStatusLabel(patient.Statut)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Actions" Sortable="false" Filterable="false" Width="170px">
                            <Template Context="patient">
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenDetails(patient))" />
                                @if (CanWrite)
                                {
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="margin-left: 6px;" Click="@(() => OpenEdit(patient))" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Style="margin-left: 6px;" Click="@(() => Delete(patient))" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>

            @if (selectedPatient is not null)
            {
                <aside class="patient-detail-card">
                    <div class="detail-header">
                        <div>
                            <p class="eyebrow small">Fiche</p>
                            <h3>@selectedPatient.NomComplet</h3>
                        </div>
                        <span class="status-pill @GetStatusClass(selectedPatient.Statut)">@GetStatusLabel(selectedPatient.Statut)</span>
                    </div>

                    <div class="detail-grid">
                        <div>
                            <span class="meta-label">Date de naissance</span>
                            <strong>@selectedPatient.DateNaissance.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div>
                            <span class="meta-label">Sexe</span>
                            <strong>@selectedPatient.Sexe</strong>
                        </div>
                        <div>
                            <span class="meta-label">Téléphone</span>
                            <strong>@(string.IsNullOrWhiteSpace(selectedPatient.Telephone) ? "—" : selectedPatient.Telephone)</strong>
                        </div>
                        <div>
                            <span class="meta-label">Email</span>
                            <strong>@(string.IsNullOrWhiteSpace(selectedPatient.Email) ? "—" : selectedPatient.Email)</strong>
                        </div>
                        <div class="full-width">
                            <span class="meta-label">Adresse</span>
                            <strong>@(string.IsNullOrWhiteSpace(selectedPatient.Adresse) ? "—" : selectedPatient.Adresse)</strong>
                        </div>
                    </div>

                    <div class="history-box">
                        <h4>Historique médical</h4>
                        <ul>
                            @foreach (var item in GetMedicalHistory(selectedPatient))
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                </aside>
            }
        </div>
    }
</div>

@code {
    [Inject]
    private ApplicationDbContext Db { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    [Inject]
    private DialogService Dialog { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private List<Patient> patients = new();
    private List<string> statusOptions = new() { "Tous", "Actif", "Inactif", "Décédé", "Transféré" };
    private bool isEditing;
    private int editingId;
    private string searchText = string.Empty;
    private string selectedStatus = "Tous";
    private Patient model = new();
    private Patient? selectedPatient;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());

    private bool CanWrite => currentUser.IsInAnyRole(RoleNames.ParcoursPatient);

    private IEnumerable<Patient> filteredPatients =>
        patients.Where(p =>
            (string.IsNullOrWhiteSpace(searchText)
                || p.NomComplet.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || p.NumeroDossier?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true)
            && (selectedStatus == "Tous" || GetStatusLabel(p.Statut) == selectedStatus));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        }
        catch (InvalidOperationException)
        {
            currentUser = new ClaimsPrincipal(new ClaimsIdentity());
        }

        await Load();
        if (patients.Count > 0)
        {
            selectedPatient = patients.First();
        }
    }

    private async Task Load()
    {
        patients = await Db.Patients
            .Include(p => p.DossierMedical)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private void OpenNew()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de créer un patient.");
            return;
        }

        editingId = 0;
        model = new Patient
        {
            DateNaissance = DateTime.Today,
            Statut = StatutPatient.Actif,
            Sexe = Sexe.Masculin
        };
        selectedPatient = null;
        isEditing = true;
    }

    private void OpenEdit(Patient patient)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de modifier un patient.");
            return;
        }

        editingId = patient.Id;
        model = new Patient
        {
            Id = patient.Id,
            Nom = patient.Nom,
            Prenom = patient.Prenom,
            DateNaissance = patient.DateNaissance,
            Sexe = patient.Sexe,
            NumeroDossier = patient.NumeroDossier,
            Telephone = patient.Telephone,
            Email = patient.Email,
            Adresse = patient.Adresse,
            GroupeSanguin = patient.GroupeSanguin,
            Allergies = patient.Allergies,
            AntecedentsMedicaux = patient.AntecedentsMedicaux,
            Statut = patient.Statut,
            CreatedAt = patient.CreatedAt
        };
        selectedPatient = patient;
        isEditing = true;
    }

    private void OpenDetails(Patient patient)
    {
        selectedPatient = patient;
        isEditing = false;
    }

    private async Task Save()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas d'enregistrer un patient.");
            return;
        }

        var validationError = HospitalValidation.ValidatePatient(
            model.Prenom,
            model.Nom,
            model.DateNaissance,
            model.Email);
        if (validationError is not null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", validationError);
            return;
        }

        var phoneError = HospitalValidation.ValidatePhone(model.Telephone);
        if (phoneError is not null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", phoneError);
            return;
        }

        try
        {
            if (editingId == 0)
            {
                if (!string.IsNullOrWhiteSpace(model.NumeroDossier)
                    && await Db.Patients.AnyAsync(p => p.NumeroDossier == model.NumeroDossier))
                {
                    Notification.Notify(NotificationSeverity.Warning, "Validation", "Ce numéro de dossier existe déjà.");
                    return;
                }

                model.NumeroDossier = await GenerateNumeroDossierAsync(model.NumeroDossier);
                model.CreatedAt = DateTime.UtcNow;
                Db.Patients.Add(model);
                await Db.SaveChangesAsync();

                Db.DossiersMedicaux.Add(new DossierMedical
                {
                    PatientId = model.Id,
                    DateOuverture = DateTime.UtcNow,
                    EstActif = true
                });
                await Db.SaveChangesAsync();
            }
            else
            {
                var existing = await Db.Patients.FindAsync(editingId);
                if (existing == null)
                {
                    Notification.Notify(NotificationSeverity.Error, "Erreur", "Patient introuvable.");
                    return;
                }

                if (!string.IsNullOrWhiteSpace(model.NumeroDossier)
                    && !string.Equals(existing.NumeroDossier, model.NumeroDossier, StringComparison.OrdinalIgnoreCase)
                    && await Db.Patients.AnyAsync(p => p.Id != editingId && p.NumeroDossier == model.NumeroDossier))
                {
                    Notification.Notify(NotificationSeverity.Warning, "Validation", "Ce numéro de dossier existe déjà.");
                    return;
                }

                existing.Nom = model.Nom;
                existing.Prenom = model.Prenom;
                existing.DateNaissance = model.DateNaissance;
                existing.Sexe = model.Sexe;
                existing.NumeroDossier = model.NumeroDossier;
                existing.Telephone = model.Telephone;
                existing.Email = model.Email;
                existing.Adresse = model.Adresse;
                existing.GroupeSanguin = model.GroupeSanguin;
                existing.Allergies = model.Allergies;
                existing.AntecedentsMedicaux = model.AntecedentsMedicaux;
                existing.Statut = model.Statut;
                existing.UpdatedAt = DateTime.UtcNow;
            }

            await Db.SaveChangesAsync();
            Notification.Notify(NotificationSeverity.Success, "Enregistré", "Le patient a été enregistré.");
            isEditing = false;
            await Load();
            selectedPatient = patients.FirstOrDefault(p => p.Id == editingId) ?? patients.FirstOrDefault();
        }
        catch (DbUpdateException)
        {
            Notification.NotifyError("Enregistrement impossible : contrainte de base de données (numéro de dossier ou e-mail en double ?).");
        }
    }

    private void Cancel()
    {
        isEditing = false;
        selectedPatient ??= patients.FirstOrDefault();
    }

    private async Task<string?> GenerateNumeroDossierAsync(string? saisie)
    {
        if (!string.IsNullOrWhiteSpace(saisie))
        {
            return saisie.Trim();
        }

        var year = DateTime.UtcNow.Year;
        var prefix = $"PAT-{year}-";
        var maxNumero = await Db.Patients
            .Where(p => p.NumeroDossier != null && p.NumeroDossier.StartsWith(prefix))
            .OrderByDescending(p => p.NumeroDossier)
            .Select(p => p.NumeroDossier!)
            .FirstOrDefaultAsync();

        var next = 1;
        if (!string.IsNullOrWhiteSpace(maxNumero)
            && int.TryParse(maxNumero[(prefix.Length)..], out var last))
        {
            next = last + 1;
        }

        return $"{prefix}{next:D4}";
    }

    private async Task Delete(Patient patient)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de supprimer un patient.");
            return;
        }

        if (!await Dialog.ConfirmDeleteAsync($"le patient {patient.NomComplet}", "Les rendez-vous, factures et dossiers associés bloqueront la suppression tant qu'ils existent."))
        {
            return;
        }

        try
        {
            var hasLinks = await Db.RendezVous.AnyAsync(r => r.PatientId == patient.Id)
                || await Db.Factures.AnyAsync(f => f.PatientId == patient.Id)
                || await Db.Consultations.AnyAsync(c => c.PatientId == patient.Id)
                || await Db.Admissions.AnyAsync(a => a.PatientId == patient.Id)
                || await Db.Analyses.AnyAsync(a => a.PatientId == patient.Id)
                || await Db.Ordonnances.AnyAsync(o => o.PatientId == patient.Id);

            if (hasLinks)
            {
                Notification.NotifyError("Suppression impossible : ce patient possède encore des rendez-vous, factures, consultations ou admissions. Archivez-le (statut Inactif) plutôt que de le supprimer.");
                return;
            }

            Db.Patients.Remove(patient);
            await Db.SaveChangesAsync();
            Notification.Notify(NotificationSeverity.Warning, "Supprimé", "Le patient a été supprimé.");
            await Load();
            selectedPatient = patients.FirstOrDefault();
        }
        catch (DbUpdateException)
        {
            Notification.NotifyError("Suppression impossible : des enregistrements liés existent encore en base (contrainte de clé étrangère).");
        }
    }

    private static string GetStatusLabel(StatutPatient statut) => statut switch
    {
        StatutPatient.Actif => "Actif",
        StatutPatient.Inactif => "Inactif",
        StatutPatient.Decede => "Décédé",
        StatutPatient.Transfere => "Transféré",
        _ => "Actif"
    };

    private static string GetStatusClass(StatutPatient statut) => statut switch
    {
        StatutPatient.Actif => "active",
        StatutPatient.Inactif => "inactive",
        StatutPatient.Decede => "deceased",
        StatutPatient.Transfere => "transferred",
        _ => "active"
    };

    private static List<string> GetMedicalHistory(Patient patient)
    {
        var items = new List<string>();

        if (!string.IsNullOrWhiteSpace(patient.Allergies))
            items.Add($"Allergies : {patient.Allergies}");

        if (!string.IsNullOrWhiteSpace(patient.AntecedentsMedicaux))
            items.Add($"Antécédents : {patient.AntecedentsMedicaux}");

        items.Add($"Dossier créé le {patient.CreatedAt:dd/MM/yyyy}");

        if (patient.UpdatedAt.HasValue)
            items.Add($"Dernière mise à jour le {patient.UpdatedAt.Value:dd/MM/yyyy}");

        return items.Count > 0 ? items : new List<string> { "Aucun historique médical enregistré pour ce patient." };
    }
}
