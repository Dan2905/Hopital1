@page "/facturation"
@attribute [Authorize(Roles = "Admin,Receptionniste")]
@using System.Security.Claims
@using HospitalManagement.Web.Components.Layout

<PageTitle>Facturation</PageTitle>

<div class="page-card">
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 16px;">
        <RadzenHeading Size="HeadingSize.H3">Facturation</RadzenHeading>
                @if (CanWrite)
        {
            <RadzenButton Text="Nouvelle facture" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => OpenNew())" />
        }
    </RadzenStack>

    <RadzenStack Direction="FlexDirection.Row" Gap="12px" AlignItems="AlignItems.Center" Style="margin-bottom: 16px;">
        <RadzenTextBox Placeholder="Rechercher (numéro, patient...)" @bind-Value="searchText" Style="width: 100%; max-width: 320px;" />
        <RadzenDropDown Data="statusOptions" @bind-Value="selectedStatus" Placeholder="Tous les statuts" Style="width: 220px;" />
    </RadzenStack>

    @if (isEditing)
    {
        <RadzenStack Gap="16px">
            <RadzenText Size="TextSize.Large">@(editingId == 0 ? "Ajouter une facture" : "Modifier la facture")</RadzenText>
            <RadzenTextBox @bind-Value="model.Numero" Placeholder="Numéro (auto si vide)" />
            <RadzenLabel Text="Patient" />
            <RadzenDropDown @bind-Value="model.PatientId" Data="@patients" TextProperty="NomComplet" ValueProperty="Id" Placeholder="Sélectionner un patient" />
            <RadzenStack Direction="FlexDirection.Row" Gap="16px">
                <RadzenStack Gap="4px" Style="flex:1">
                    <RadzenLabel Text="Date d'émission" />
                    <RadzenDatePicker @bind-Value="model.DateEmission" />
                </RadzenStack>
                <RadzenStack Gap="4px" Style="flex:1">
                    <RadzenLabel Text="Date d'échéance" />
                    <RadzenDatePicker @bind-Value="model.DateEcheance" />
                </RadzenStack>
            </RadzenStack>
            <RadzenLabel Text="Statut" />
            <RadzenDropDown @bind-Value="model.Statut" Data="Enum.GetValues<StatutFacture>()" />
            <RadzenTextArea @bind-Value="model.Notes" Placeholder="Notes" />

            <RadzenHeading Size="HeadingSize.H5">Lignes de facture</RadzenHeading>
            @foreach (var ligne in lignes)
            {
                <RadzenStack Direction="FlexDirection.Row" Gap="8px" AlignItems="AlignItems.End">
                    <RadzenStack Gap="4px" Style="flex:2">
                        <RadzenLabel Text="Désignation" />
                        <RadzenTextBox @bind-Value="ligne.Designation" Placeholder="Prestation, médicament..." />
                    </RadzenStack>
                    <RadzenStack Gap="4px" Style="flex:0 0 110px">
                        <RadzenLabel Text="Quantité" />
                        <RadzenNumeric TValue="int" @bind-Value="ligne.Quantite" Min="1" Change="@(_ => RecalculateTotal())" />
                    </RadzenStack>
                    <RadzenStack Gap="4px" Style="flex:0 0 160px">
                        <RadzenLabel Text="Prix unitaire" />
                        <RadzenNumeric TValue="decimal" @bind-Value="ligne.PrixUnitaire" Format="C2" Min="0m" Change="@(_ => RecalculateTotal())" />
                    </RadzenStack>
                    <RadzenText Style="min-width:110px; text-align:right">@ligne.Montant.ToString("C2")</RadzenText>
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveLigne(ligne))" />
                </RadzenStack>
            }
            <RadzenButton Text="Ajouter une ligne" Icon="add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@AddLigne" />
            <RadzenStack Direction="FlexDirection.Row" Gap="16px" JustifyContent="JustifyContent.End">
                <RadzenText><strong>Total : @model.MontantTotal.ToString("C2")</strong></RadzenText>
                <RadzenStack Gap="4px" Style="width:200px">
                    <RadzenLabel Text="Montant payé" />
                    <RadzenNumeric TValue="decimal" @bind-Value="model.MontantPaye" Format="C2" Min="0m" />
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Direction="FlexDirection.Row" Gap="8px">
                <RadzenButton Text="Enregistrer" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
            </RadzenStack>
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid Data="@filteredFactures" AllowPaging="true" AllowSorting="true" PageSize="10" EmptyText="Aucune facture.">
            <Columns>
                <RadzenDataGridColumn Property="Numero" Title="Numéro" />
                <RadzenDataGridColumn Title="Patient">
                    <Template>
                        @(context?.Patient?.NomComplet ?? "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="DateEmission" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn Title="Total" Sortable="true">
                    <Template>
                        @context!.MontantTotal.ToString("C2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Payé" Sortable="false">
                    <Template>
                        @context!.MontantPaye.ToString("C2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Restant" Sortable="false">
                    <Template>
                        @context!.MontantRestant.ToString("C2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Statut" Sortable="false">
                    <Template>
                        <span class="status-pill @GetStatusClass(context!.Statut)">@GetStatusLabel(context!.Statut)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="" Sortable="false" Width="230px">
                    <Template>
                                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Title="Détail / paiements" Click="@(() => OpenPayments(context!))" />
                        @if (CanWrite)
                        {
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="margin-left: 6px;" Click="@(() => OpenEdit(context!))" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Style="margin-left: 6px;" Click="@(() => Delete(context!))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (selectedFacture is not null)
        {
            <RadzenStack Gap="12px" Style="margin-top: 24px;" class="editor-card">
                <RadzenStack Direction="FlexDirection.Row" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText Size="TextSize.Large"><strong>@selectedFacture.Numero</strong> — @selectedFacture.Patient?.NomComplet</RadzenText>
                    <span class="status-pill @GetStatusClass(selectedFacture.Statut)">@GetStatusLabel(selectedFacture.Statut)</span>
                </RadzenStack>
                <RadzenText>Total : <strong>@selectedFacture.MontantTotal.ToString("C2")</strong> — Payé : <strong>@selectedFacture.MontantPaye.ToString("C2")</strong> — Reste : <strong>@selectedFacture.MontantRestant.ToString("C2")</strong></RadzenText>
                <RadzenHeading Size="HeadingSize.H6">Paiements (@selectedFacture.Paiements.Count)</RadzenHeading>
                @if (selectedFacture.Paiements.Count == 0)
                {
                    <RadzenText>Aucun paiement enregistré.</RadzenText>
                }
                else
                {
                    <RadzenText>@string.Join(" | ", selectedFacture.Paiements.Select(p => $"{p.DatePaiement:dd/MM/yyyy} — {p.Montant:C2} ({p.Mode})"))</RadzenText>
                }
                <RadzenStack Direction="FlexDirection.Row" Gap="8px" AlignItems="AlignItems.End">
                    <RadzenStack Gap="4px" Style="width:200px">
                        <RadzenLabel Text="Montant" />
                        <RadzenNumeric TValue="decimal" @bind-Value="paymentAmount" Format="C2" Min="0.01m" />
                    </RadzenStack>
                    <RadzenStack Gap="4px" Style="width:200px">
                        <RadzenLabel Text="Mode" />
                        <RadzenDropDown @bind-Value="paymentMode" Data="Enum.GetValues<ModePaiement>()" />
                    </RadzenStack>
                    <RadzenStack Gap="4px" Style="flex:1">
                        <RadzenLabel Text="Référence" />
                        <RadzenTextBox @bind-Value="paymentReference" Placeholder="Référence / reçu" />
                    </RadzenStack>
                                        @if (CanWrite)
                    {
                        <RadzenButton Text="Encaisser" Icon="payments" ButtonStyle="ButtonStyle.Success" Click="@RegisterPayment" Disabled="@(selectedFacture.MontantRestant <= 0)" />
                    }
                </RadzenStack>
            </RadzenStack>
        }
    }
</div>

@code {
    [Inject]
    private ApplicationDbContext Db { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    [Inject]
    private DialogService Dialog { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());

    private bool CanWrite => currentUser.IsInAnyRole(RoleNames.Facturation);

    private List<Facture> factures = new();
    private List<Patient> patients = new();
    private List<FactureLigne> lignes = new();
    private Facture? selectedFacture;
    private bool isEditing;
    private int editingId;
    private Facture model = new();
    private string searchText = string.Empty;
    private string selectedStatus = "Tous";
    private List<string> statusOptions = new() { "Tous", "En attente", "Émise", "Partiellement payée", "Payée", "Annulée" };
    private decimal paymentAmount;
    private ModePaiement paymentMode = ModePaiement.Especes;
    private string? paymentReference;

    private IEnumerable<Facture> filteredFactures =>
        factures.Where(f =>
            (string.IsNullOrWhiteSpace(searchText)
                || f.Numero.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (f.Patient?.NomComplet?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true))
            && (selectedStatus == "Tous" || GetStatusLabel(f.Statut) == selectedStatus));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        }
        catch (InvalidOperationException)
        {
            currentUser = new ClaimsPrincipal(new ClaimsIdentity());
        }

        await Load();
    }

    private async Task Load()
    {
        factures = await Db.Factures
            .Include(f => f.Patient)
            .Include(f => f.Lignes)
            .Include(f => f.Paiements)
            .OrderByDescending(f => f.DateEmission)
            .ToListAsync();
        patients = await Db.Patients.OrderBy(p => p.Nom).ToListAsync();
    }

    private void OpenNew()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de créer une facture.");
            return;
        }

        editingId = 0;
        model = new Facture { DateEmission = DateTime.Today, Statut = StatutFacture.EnAttente };
        lignes = new List<FactureLigne> { NewLigne() };
        RecalculateTotal();
        selectedFacture = null;
        isEditing = true;
    }

    private async Task OpenEdit(Facture f)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de modifier une facture.");
            return;
        }

        editingId = f.Id;
        var facture = await Db.Factures.Include(x => x.Lignes).FirstOrDefaultAsync(x => x.Id == f.Id);
        model = new Facture
        {
            Id = f.Id,
            Numero = f.Numero,
            PatientId = f.PatientId,
            ConsultationId = f.ConsultationId,
            DateEmission = f.DateEmission,
            DateEcheance = f.DateEcheance,
            MontantTotal = f.MontantTotal,
            MontantPaye = f.MontantPaye,
            Statut = f.Statut,
            Notes = f.Notes,
            CreatedAt = f.CreatedAt
        };
        lignes = (facture?.Lignes ?? Enumerable.Empty<FactureLigne>())
            .Select(l => new FactureLigne
            {
                Id = l.Id,
                FactureId = l.FactureId,
                Designation = l.Designation,
                Quantite = l.Quantite,
                PrixUnitaire = l.PrixUnitaire
            }).ToList();
        if (lignes.Count == 0)
        {
            lignes.Add(NewLigne());
        }
        RecalculateTotal();
        isEditing = true;
    }

    private static FactureLigne NewLigne() => new() { Designation = string.Empty, Quantite = 1, PrixUnitaire = 0 };

    private void AddLigne() => lignes.Add(NewLigne());

    private void RemoveLigne(FactureLigne ligne)
    {
        lignes.Remove(ligne);
        RecalculateTotal();
    }

    private void RecalculateTotal()
    {
        model.MontantTotal = lignes.Sum(l => l.Quantite * l.PrixUnitaire);
    }

    private async Task OpenPayments(Facture f)
    {
        selectedFacture = await Db.Factures
            .Include(x => x.Patient)
            .Include(x => x.Lignes)
            .Include(x => x.Paiements)
            .FirstOrDefaultAsync(x => x.Id == f.Id);
        paymentAmount = selectedFacture?.MontantRestant > 0 ? selectedFacture.MontantRestant : 0;
        paymentMode = ModePaiement.Especes;
        paymentReference = null;
        isEditing = false;
    }

    private async Task RegisterPayment()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas d'enregistrer un paiement.");
            return;
        }

        if (selectedFacture is null)
        {
            return;
        }

        var error = HospitalValidation.ValidatePayment(selectedFacture.MontantTotal, selectedFacture.MontantPaye, paymentAmount);
        if (error is not null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", error);
            return;
        }

        var facture = await Db.Factures.FindAsync(selectedFacture.Id);
        if (facture is null)
        {
            return;
        }

        Db.Paiements.Add(new Paiement
        {
            FactureId = facture.Id,
            DatePaiement = DateTime.Now,
            Montant = paymentAmount,
            Mode = paymentMode,
            Statut = StatutPaiement.Confirme,
            Reference = paymentReference
        });
        facture.MontantPaye += paymentAmount;
        facture.Statut = DeriveStatus(facture.MontantTotal, facture.MontantPaye);
        facture.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();

        Notification.NotifySuccess($"Paiement de {paymentAmount:C2} enregistré.");
        paymentAmount = 0;
        paymentReference = null;
        await Load();
        await OpenPayments(facture);
    }

    private async Task Save()
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas d'enregistrer une facture.");
            return;
        }

        RecalculateTotal();
        model.Numero = await GenerateNumeroAsync(model.Numero);

        var error = HospitalValidation.ValidateInvoice(model.Numero, model.PatientId, model.MontantTotal, model.MontantPaye);
        if (error is not null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", error);
            return;
        }

        if (lignes.Any(l => string.IsNullOrWhiteSpace(l.Designation) || l.Quantite <= 0 || l.PrixUnitaire < 0))
        {
            Notification.Notify(NotificationSeverity.Warning, "Validation", "Chaque ligne doit avoir une désignation, une quantité positive et un prix valide.");
            return;
        }

        if (editingId == 0)
        {
            if (await Db.Factures.AnyAsync(f => f.Numero == model.Numero))
            {
                Notification.Notify(NotificationSeverity.Warning, "Validation", "Ce numéro de facture existe déjà.");
                return;
            }

            model.Statut = DeriveStatus(model.MontantTotal, model.MontantPaye);
            Db.Factures.Add(model);
            await Db.SaveChangesAsync();

            foreach (var ligne in lignes)
            {
                ligne.Id = 0;
                ligne.FactureId = model.Id;
                Db.FactureLignes.Add(ligne);
            }
        }
        else
        {
            var existing = await Db.Factures.Include(f => f.Lignes).FirstOrDefaultAsync(f => f.Id == editingId);
            if (existing == null)
            {
                return;
            }

            if (await Db.Factures.AnyAsync(f => f.Id != editingId && f.Numero == model.Numero))
            {
                Notification.Notify(NotificationSeverity.Warning, "Validation", "Ce numéro de facture existe déjà.");
                return;
            }

            existing.Numero = model.Numero;
            existing.PatientId = model.PatientId;
            existing.DateEmission = model.DateEmission;
            existing.DateEcheance = model.DateEcheance;
            existing.MontantTotal = model.MontantTotal;
            existing.MontantPaye = model.MontantPaye;
            existing.Statut = DeriveStatus(existing.MontantTotal, model.MontantPaye);
            existing.Notes = model.Notes;
            existing.UpdatedAt = DateTime.UtcNow;

            Db.FactureLignes.RemoveRange(existing.Lignes);
            foreach (var ligne in lignes)
            {
                Db.FactureLignes.Add(new FactureLigne
                {
                    FactureId = existing.Id,
                    Designation = ligne.Designation,
                    Quantite = ligne.Quantite,
                    PrixUnitaire = ligne.PrixUnitaire
                });
            }
        }
        await Db.SaveChangesAsync();
        Notification.Notify(NotificationSeverity.Success, "Enregistré", "La facture a été enregistrée.");
        isEditing = false;
        await Load();
    }

    private async Task<string> GenerateNumeroAsync(string? saisie)
    {
        if (!string.IsNullOrWhiteSpace(saisie))
        {
            return saisie.Trim();
        }

        var year = DateTime.UtcNow.Year;
        var prefix = $"FAC-{year}-";
        var maxNumero = await Db.Factures
            .Where(f => f.Numero.StartsWith(prefix))
            .OrderByDescending(f => f.Numero)
            .Select(f => f.Numero)
            .FirstOrDefaultAsync();

        var next = 1;
        if (!string.IsNullOrWhiteSpace(maxNumero) && int.TryParse(maxNumero[(prefix.Length)..], out var last))
        {
            next = last + 1;
        }

        return $"{prefix}{next:D4}";
    }

    private static StatutFacture DeriveStatus(decimal total, decimal paye) => (total, paye) switch
    {
        (_, _) when paye <= 0 => StatutFacture.Emise,
        (_, _) when paye >= total && total > 0 => StatutFacture.Payee,
        (_, _) when paye > 0 => StatutFacture.PartiellementPayee,
        _ => StatutFacture.EnAttente
    };

    private static string GetStatusLabel(StatutFacture statut) => statut switch
    {
        StatutFacture.Emise => "Émise",
        StatutFacture.PartiellementPayee => "Partiellement payée",
        StatutFacture.Payee => "Payée",
        StatutFacture.Annulee => "Annulée",
        StatutFacture.EnAttente => "En attente",
        _ => "En attente"
    };

    private static string GetStatusClass(StatutFacture statut) => statut switch
    {
        StatutFacture.Payee => "completed",
        StatutFacture.PartiellementPayee => "confirmed",
        StatutFacture.Annulee => "cancelled",
        _ => "scheduled"
    };

    private void Cancel() => isEditing = false;

    private async Task Delete(Facture f)
    {
        if (!CanWrite)
        {
            Notification.NotifyWarning("Votre rôle ne permet pas de supprimer une facture.");
            return;
        }

        if (!await Dialog.ConfirmDeleteAsync($"la facture {f.Numero}"))
        {
            return;
        }

        var hasPayments = await Db.Paiements.AnyAsync(p => p.FactureId == f.Id);
        if (hasPayments)
        {
            Notification.NotifyError("Suppression impossible : des paiements sont déjà rattachés à cette facture. Annulez-la plutôt que de la supprimer.");
            return;
        }

        var facture = await Db.Factures.Include(x => x.Lignes).FirstOrDefaultAsync(x => x.Id == f.Id);
        if (facture is null)
        {
            return;
        }

        Db.FactureLignes.RemoveRange(facture.Lignes);
        Db.Factures.Remove(facture);
        await Db.SaveChangesAsync();

        if (selectedFacture?.Id == f.Id)
        {
            selectedFacture = null;
        }

        Notification.Notify(NotificationSeverity.Warning, "Supprimé", "La facture a été supprimée.");
        await Load();
    }
}
