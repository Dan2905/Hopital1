@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using HospitalManagement.Web.Components.Layout

<RadzenDialog />
<RadzenNotification />

<div class="hospital-shell">
    <AuthorizeView>
        <Authorized>
            <NavMenu />

            <div class="hospital-body">
                <main class="hospital-main">
                    @Body
                </main>

                <footer class="hospital-footer">
                    <span>Gestion hospitalière — plateforme de pilotage</span>
                    <span>Session du @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </footer>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="hospital-body hospital-body-auth">
                <main class="hospital-main hospital-main-auth">
                    @Body
                </main>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
